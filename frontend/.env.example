# Copy to .env and adjust if needed. Never commit .env.
#
# Only public, non-secret configuration belongs here (Vite exposes every
# VITE_-prefixed variable to client-side code — CLAUDE.md's "the frontend
# never computes a number" boundary extends to "the frontend never holds
# a secret" too). The Gemini API key, the database URL, and every other
# backend credential live only in the repo root's .env, read by the
# FastAPI process — never here.

# Base URL of the WealthPilot FastAPI backend (Phase 15).
VITE_API_BASE_URL=http://localhost:8000
