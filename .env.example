# Copy to .env and fill in real values. Never commit .env.

# Gemini API key — used only by the backend: the AutoGen strategy debate
# (agents/debate.py, Phase 12 — three bounded personas critiquing an
# already-approved, already-compliant allocation, never calculating a
# number themselves) and explanation generation (agents/explanation.py,
# Phase 13). Never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_PROJECT_NUMBER=
GEMINI_MODEL=

# PostgreSQL connection string, e.g.:
# postgresql+psycopg://wealthpilot:wealthpilot@localhost:5432/wealthpilot
DATABASE_URL=

# Separate database used by the test suite (Phase 1+). Keep this distinct
# from DATABASE_URL so tests never touch development data.
TEST_DATABASE_URL=

# development | test | production
ENVIRONMENT=development

# Python's logging levels: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
