# Copy to .env and fill in real values. Never commit .env.

# Gemini API key — used only by the backend: the AutoGen strategy debate
# (agents/debate.py, Phase 12 — three bounded personas critiquing an
# already-approved, already-compliant allocation, never calculating a
# number themselves) and explanation generation (agents/explanation.py,
# Phase 13). Never exposed to the frontend.
GEMINI_API_KEY=
GEMINI_PROJECT_NUMBER=
GEMINI_MODEL=

# PostgreSQL connection string, e.g.:
# postgresql+psycopg://wealthpilot:wealthpilot@localhost:5432/wealthpilot
DATABASE_URL=

# Separate database used by the test suite (Phase 1+). Keep this distinct
# from DATABASE_URL so tests never touch development data.
TEST_DATABASE_URL=

# development | test | production
ENVIRONMENT=development

# Python's logging levels: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Sensitive-data protection prototype (ADR-047, docs/THREAT_MODEL.md). Leave these EMPTY to disable protected notes: the feature then
# fails closed (503) and reports "not configured" -- there is no built-in default key. The development key provider reads keys from
# the environment; that is NOT a managed KMS. Never commit a real value, and back keys up separately from database backups.
#   PROTECTED_DATA_KEYS=<key_id>:<base64 of 32 random bytes>[,<key_id>:<base64 of 32 random bytes>...]
#   PROTECTED_DATA_ACTIVE_KEY_ID=<key_id used for NEW notes; keep older ids listed so older notes still decrypt>
# To make one key (run it yourself; the value is secret):
#   python -c "import secrets,base64; print('k1:' + base64.b64encode(secrets.token_bytes(32)).decode())"
PROTECTED_DATA_KEYS=
PROTECTED_DATA_ACTIVE_KEY_ID=

# Trained sentiment model (ADR-052, docs/SECURITY.md). OFF by default: the deterministic rules baseline is then the method. Turning it on needs the approved
# deep-learning packages AND a validated artifact under models/sentiment/<version>/ (training/sentiment/README.md); otherwise the rules baseline answers and says why.
SENTIMENT_MODEL_ENABLED=false
SENTIMENT_MODEL_NAME=
SENTIMENT_MODEL_PATH=
SENTIMENT_MODEL_VERSION=
SENTIMENT_MODEL_MIN_CONFIDENCE=
SENTIMENT_MODEL_ALLOW_FALLBACK=true
SENTIMENT_MODEL_MAX_TOKENS=
SENTIMENT_MODEL_DEVICE=cpu
SENTIMENT_MODEL_TIMEOUT_SECONDS=

# Research-only comparison of two pretrained classifiers, FinBERT and Twitter-RoBERTa (ADR-053). OFF by default and display-only. Neither candidate is currently permitted to run (licence /
# safetensors findings in docs/sentiment/model_licence_review.md); switching this on today only reports that. The rules baseline stays the production method either way.
SENTIMENT_TRANSFORMERS_ENABLED=false
SENTIMENT_TRANSFORMERS_MAX_TOKENS=
SENTIMENT_TRANSFORMERS_TIMEOUT_SECONDS=
SENTIMENT_TRANSFORMERS_DEVICE=cpu
SENTIMENT_TRANSFORMERS_THREADS=

# Fictional demonstration data for /financial-behaviour?demo=true (development only). Keep false everywhere else; it never touches the database.
DEMO_MODE_ENABLED=false

# Deployment only (Render): the FAR-Trans CSVs are third-party data kept out of git. If datasets/raw/FAR-Trans/ lacks the four required files,
# scripts/fetch_far_trans.py downloads a zip of them from FAR_TRANS_URL at startup. Leave all three EMPTY locally (the files are already present).
# The URL and token are secrets: set them in the Render dashboard, never commit a real value.
#   FAR_TRANS_URL=<private https URL of a zip containing customer_information.csv, asset_information.csv, transactions.csv, close_prices.csv>
#   FAR_TRANS_SHA256=<hex SHA-256 of that zip; optional but recommended>
#   FAR_TRANS_AUTH_HEADER=<e.g. "Bearer <token>"; only if the URL needs authentication>
FAR_TRANS_URL=
FAR_TRANS_SHA256=
FAR_TRANS_AUTH_HEADER=
