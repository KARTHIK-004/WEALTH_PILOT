# Environment
.env
.env.local
.venv/
venv/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend
node_modules/
dist/
frontend/dist/
.vite/

# Trained model artifacts — binaries are never tracked; metrics.json IS
# tracked, since the report's performance tables are generated from it.
models/**/*.pkl
models/**/*.keras
models/**/*.joblib
models/**/*.h5
!models/metrics.json

# OS
.DS_Store
Thumbs.db

datasets/raw/*
!datasets/raw/.gitkeep

# Synthetic ML training dataset (ADR-039): large, regenerable CSVs are not tracked.
# Regenerate: python scripts/generate_wealthpilot_synthetic_dataset.py (seed 42, byte-identical)
datasets/generated/**/*.csv
